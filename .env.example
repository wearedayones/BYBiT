# ─────────────────────────────────────────────────────────────────
# Bybit API credentials
# Create a sub-account key at Bybit → API Management
# Permissions: Read + Trade ONLY (NEVER enable Withdraw)
# Strongly recommended: bind to your server's IP address
# ─────────────────────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ─────────────────────────────────────────────────────────────────
# Supabase / PostgreSQL — your DATABASE_URL connection string
# Format: postgresql://user:password@host:5432/dbname
# All agent state, trades, decisions, and performance history live here.
# The agent auto-runs migrations at startup.
# ─────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────
# Email reports — daily, weekly, and monthly performance summaries
# Use your Gmail address and a Gmail App Password (NOT your main password)
# Get one at: Google Account → Security → 2-Step Verification → App Passwords
# ─────────────────────────────────────────────────────────────────
REPORT_EMAIL=
REPORT_EMAIL_APP_PASSWORD=

# ─────────────────────────────────────────────────────────────────
# Optional — only needed if your GitHub repo is private,
# or to raise the GitHub API rate limit for auto-update polling
# ─────────────────────────────────────────────────────────────────
# GITHUB_TOKEN=
