# ─────────────────────────────────────────────────────────────────
# Bybit API credentials
# Create a sub-account key at Bybit → API Management
# Permissions: Read + Trade ONLY (NEVER enable Withdraw)
# Strongly recommended: bind to your server's IP address
#
# Two signing methods are supported — set ONE of the secret options below:
#   • HMAC (Bybit-generated key): you received a Secret string  → BYBIT_API_SECRET
#   • RSA  (self-generated / AI sub-account): you uploaded a public key to Bybit
#     and kept the private key locally          → BYBIT_API_PRIVATE_KEY_PATH
# If both are set, RSA is used.
# ─────────────────────────────────────────────────────────────────
BYBIT_API_KEY=

# HMAC: paste the Secret string Bybit showed you once at key creation
BYBIT_API_SECRET=

# RSA option A — path to PEM file (leave BYBIT_API_SECRET blank if using RSA)
# BYBIT_API_PRIVATE_KEY_PATH=/absolute/path/to/bybit_private.pem

# RSA option B — paste inline PEM (for cloud/container setups where file paths are fragile)
# BYBIT_API_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ─────────────────────────────────────────────────────────────────
# Supabase / PostgreSQL — your DATABASE_URL connection string
# Format: postgresql://user:password@host:5432/dbname
# All agent state, trades, decisions, and performance history live here.
# The agent auto-runs migrations at startup.
# ─────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────
# Email reports — daily, weekly, and monthly performance summaries
# Use your Gmail address and a Gmail App Password (NOT your main password)
# Get one at: Google Account → Security → 2-Step Verification → App Passwords
# ─────────────────────────────────────────────────────────────────
REPORT_EMAIL=
REPORT_EMAIL_APP_PASSWORD=

# ─────────────────────────────────────────────────────────────────
# Optional — only needed if your GitHub repo is private,
# or to raise the GitHub API rate limit for auto-update polling
# ─────────────────────────────────────────────────────────────────
# GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────────
# Optional — news & sentiment (newsapi.org free tier)
# Without this, the agent uses free sources automatically:
#   Fear & Greed Index (alternative.me), CoinGecko trending, CoinDesk RSS
# With this key, richer symbol-specific news headlines are included.
# Get a free key at: https://newsapi.org/register
# ─────────────────────────────────────────────────────────────────
# NEWS_API_KEY=
