{
  "name": "bybit-agent",
  "version": "1.0.0",
  "description": "Fully autonomous 24/7 AI trading agent for Bybit",
  "main": "dist/index.js",
  "scripts": {
    "start": "npm run build && node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc && node -e \"require('fs').writeFileSync('dist/.version', require('child_process').execSync('git rev-parse HEAD').toString().trim())\"",
    "fetch-skill": "tsx scripts/fetch-skill.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "simulate": "tsx src/simulation/run-simulation.ts",
    "postinstall": "tsx scripts/fetch-skill.ts || true"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bottleneck": "^2.19.5",
    "decimal.js": "^10.4.3",
    "nodemailer": "^6.9.15",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "technicalindicators": "^3.1.0",
    "undici": "^6.21.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
